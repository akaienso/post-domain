{
    "name": "akaienso/post-domain",
    "description": "Maps a domain name to a single WordPress post, resolved rather than redirected.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.1",
        "symfony/polyfill-intl-idn": "1.38.1",
        "jeremykendall/php-domain-parser": "^6.3",
        "symfony/polyfill-intl-normalizer": "^1.42"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "yoast/phpunit-polyfills": "^2.0",
        "squizlabs/php_codesniffer": "^3.7",
        "wp-coding-standards/wpcs": "^3.0",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "phpstan/phpstan": "^1.10",
        "szepeviktor/phpstan-wordpress": "^1.3"
    },
    "autoload": {
        "psr-4": {
            "PostDomain\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PostDomain\\Tests\\": "tests/",
            "PostDomain\\Tests\\Fixtures\\": "tests/Fixtures/"
        }
    },
    "config": {
        "platform": {
            "php": "8.1"
        },
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "scripts": {
        "test": "phpunit --testsuite unit",
        "test:integration": "bin/integration-env.sh && WP_TESTS_DIR=$PWD/tmp/wp-tests phpunit -c phpunit-integration.xml.dist",
        "lint": "phpcs",
        "analyse": "phpstan analyse --memory-limit=1G",
        "lint:plans": "php bin/check-plan-examples.php",
        "test:integration:wp-env": "wp-env run tests-cli --env-cwd=wp-content/plugins/post-domain vendor/bin/phpunit -c phpunit-integration.xml.dist",
        "generate:status-map": "php bin/generate-cloudflare-status-map.php"
    }
}
