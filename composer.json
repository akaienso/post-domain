{
	"name": "akaienso/post-domain",
	"description": "Maps a domain name to a single WordPress post, resolved rather than redirected.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=8.1",
		"symfony/polyfill-intl-idn": "1.38.1",
		"jeremykendall/php-domain-parser": "^6.3"
	},
	"require-dev": {
		"phpunit/phpunit": "^9.6",
		"yoast/phpunit-polyfills": "^2.0",
		"squizlabs/php_codesniffer": "^3.7",
		"wp-coding-standards/wpcs": "^3.0",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0",
		"phpstan/phpstan": "^1.10",
		"szepeviktor/phpstan-wordpress": "^1.3"
	},
	"autoload": {
		"psr-4": { "PostDomain\\": "src/" }
	},
	"autoload-dev": {
		"psr-4": {
			"PostDomain\\Tests\\": "tests/",
			"PostDomain\\Tests\\Fixtures\\": "tests/Fixtures/"
		}
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	},
	"scripts": {
		"test": "phpunit --testsuite unit",
		"test:integration": "phpunit --testsuite integration",
		"lint": "phpcs",
		"analyse": "phpstan analyse",
		"lint:plans": "php bin/check-plan-examples.php"
	}
}
